/* Phase Board (S3) - light theme, matches Figma */

/* ---------- header ---------- */
QLabel#PageTitle      { font-size: 30px; font-weight: 800; color: #1A1A1F; background: transparent; }
QLabel#ModelLabel     { font-size: 14px; color: #6B6B73; background: transparent; }
QLabel#ModelValue     { font-size: 14px; font-weight: 700; color: #5438DC; background: transparent; }
QLabel#TaskCountLabel { font-size: 14px; color: #6B6B73; background: transparent; }

QLineEdit#BoardSearch, QComboBox#BoardMemberFilter {
    background: #FFFFFF; border: 1px solid #E7E2D6; border-radius: 20px;
    padding: 9px 18px; min-height: 22px; font-size: 15px; color: #1A1A1F;
}
QLineEdit#BoardSearch:focus, QComboBox#BoardMemberFilter:focus { border: 1px solid #5438DC; }

/* ---------- buttons ---------- */
QPushButton#BoardPrimary {
    background: #5438DC; color: #FFFFFF; border: none; border-radius: 14px;
    padding: 11px 22px; font-size: 15px; font-weight: 700;
}
QPushButton#BoardPrimary:hover { background: #4A2FC9; }
QPushButton#BoardSecondary {
    background: #F5F2EA; color: #1A1A1F; border: 1px solid #E0DBCF; border-radius: 14px;
    padding: 11px 22px; font-size: 15px; font-weight: 700;
}
QPushButton#BoardSecondary:hover { background: #ECE7DC; }

/* ---------- combo popup + arrow ---------- */
QComboBox#BoardMemberFilter, QDialog#NewTaskDialog QComboBox { padding-right: 40px; }
QComboBox#BoardMemberFilter::drop-down, QDialog#NewTaskDialog QComboBox::drop-down {
    subcontrol-origin: padding; subcontrol-position: center right;
    width: 36px; border: none; background: transparent;
}
QComboBox#BoardMemberFilter::down-arrow, QDialog#NewTaskDialog QComboBox::down-arrow {
    image: url(:/icons/chevron-updown.svg); width: 16px; height: 16px;
}
QComboBox#BoardMemberFilter QAbstractItemView, QDialog#NewTaskDialog QComboBox QAbstractItemView {
    background: #FFFFFF; border: 1px solid #E7E2D6; border-radius: 12px; padding: 6px;
    outline: 0; color: #1A1A1F; font-size: 15px;
    selection-background-color: #F3F0FF; selection-color: #1A1A1F;
}
QComboBox#BoardMemberFilter QAbstractItemView::item, QDialog#NewTaskDialog QComboBox QAbstractItemView::item { min-height: 34px; padding: 2px 10px; border-radius: 8px; }

/* ---------- columns ---------- */
QScrollArea#BoardScroll { background: transparent; border: none; }
QWidget#BoardColumnsHost { background: transparent; }
QScrollArea#BoardScroll QScrollBar:horizontal { height: 8px; background: transparent; margin: 0 4px; }
QScrollArea#BoardScroll QScrollBar::handle:horizontal { background: #D9D4C8; border-radius: 4px; min-width: 30px; }
QScrollArea#BoardScroll QScrollBar::add-line:horizontal,
QScrollArea#BoardScroll QScrollBar::sub-line:horizontal { width: 0; }

QFrame#TaskColumn { background: #FFFFFF; border: 1px solid #E7E2D6; border-radius: 26px; }
QLabel#ColumnTitle { font-size: 17px; font-weight: 700; color: #1A1A1F; background: transparent; }
QLabel#ColumnCount {
    background: #EFECE5; color: #1A1A1F; border-radius: 10px; padding: 3px 12px;
    font-size: 14px; font-weight: 700;
}
QLabel#ColumnCount[tone="progress"] { background: #EAE5FF; color: #5438DC; }
QLabel#ColumnCount[tone="review"]   { background: #FDEFC7; color: #92400E; }
QLabel#ColumnCount[tone="done"]     { background: #D4F981; color: #3F6212; }
QFrame#ColumnDivider { background: #E9E5DB; border: none; }

QScrollArea#ColumnScroll { background: transparent; border: none; }
QWidget#ColumnViewport, QWidget#ColumnContainer { background: transparent; }
QScrollArea#ColumnScroll QScrollBar:vertical { width: 8px; background: transparent; margin: 4px 0; }
QScrollArea#ColumnScroll QScrollBar::handle:vertical { background: #D9D4C8; border-radius: 4px; min-height: 30px; }
QScrollArea#ColumnScroll QScrollBar::add-line:vertical,
QScrollArea#ColumnScroll QScrollBar::sub-line:vertical { height: 0; }

/* ---------- cards ---------- */
QFrame#TaskCard { background: #F5F2EA; border: 1px solid #E7E2D6; border-radius: 20px; }
QLabel#SkillChip {
    background: #F3F0FF; color: #5438DC; border: 1px solid #5438DC; border-radius: 12px;
    padding: 5px 14px; font-size: 13px; font-weight: 700;
}
QFrame#BlockedBadge { background: #FAF8F5; border: 1px solid #E7E2D6; border-radius: 12px; }
QLabel#BlockedIcon  { font-size: 14px; background: transparent; }
QLabel#BlockedText  { font-size: 12px; font-weight: 600; color: #1A1A1F; background: transparent; }
QLabel#TaskTitle    { font-size: 17px; font-weight: 700; color: #1A1A1F; background: transparent; }
QFrame#CardDivider  { background: #E3DFD4; border: none; }
QLabel#CardAvatar {
    background: #FFFFFF; border: 1px solid #E0DBCF; border-radius: 17px;
    font-size: 12px; font-weight: 700; color: #1A1A1F;
}
QLabel#CardMeta  { font-size: 14px; color: #6B6B73; background: transparent; }
QLabel#DoneMark  { font-size: 20px; font-weight: 700; color: #1A1A1F; background: transparent; }
QToolButton#AdvanceButton {
    border: none; background: transparent; color: #1A1A1F; font-size: 20px;
    padding: 0 6px; border-radius: 10px;
}
QToolButton#AdvanceButton:hover { background: #E6E1D5; }

/* ---------- new task dialog ---------- */
QDialog#NewTaskDialog { background: transparent; }
QFrame#DialogCard   { background: #EAE6DF; border-radius: 30px; }
QFrame#DialogHeader { background: transparent; border: none; border-bottom: 1px solid #DDD8CC; }
QLabel#DialogTitle  { font-size: 26px; font-weight: 800; color: #1A1A1F; background: transparent; }
QToolButton#DialogClose {
    border: none; background: transparent; color: #1A1A1F; font-size: 26px;
    padding: 0 8px; border-radius: 12px;
}
QToolButton#DialogClose:hover { background: #DDD8CC; }

QScrollArea#DialogScroll { background: transparent; border: none; }
QWidget#DialogViewport, QWidget#DialogBody { background: transparent; }
QScrollArea#DialogScroll QScrollBar:vertical { width: 8px; background: transparent; margin: 4px 0; }
QScrollArea#DialogScroll QScrollBar::handle:vertical { background: #CFCABD; border-radius: 4px; min-height: 30px; }
QScrollArea#DialogScroll QScrollBar::add-line:vertical,
QScrollArea#DialogScroll QScrollBar::sub-line:vertical { height: 0; }

QLabel#FieldLabel { font-size: 15px; font-weight: 600; color: #6B6B73; background: transparent; }
QDialog#NewTaskDialog QLineEdit, QDialog#NewTaskDialog QComboBox,
QDialog#NewTaskDialog QSpinBox, QDialog#NewTaskDialog QListWidget {
    background: #FFFFFF; border: 1px solid #EFEBE3; border-radius: 18px;
    padding: 12px 18px; min-height: 26px; font-size: 16px; color: #1A1A1F;
}
QDialog#NewTaskDialog QLineEdit:focus, QDialog#NewTaskDialog QComboBox:focus,
QDialog#NewTaskDialog QSpinBox:focus { border: 1px solid #5438DC; }
QDialog#NewTaskDialog QListWidget { padding: 8px; min-height: 0; }
QComboBox#BoardMemberFilter, QDialog#NewTaskDialog QComboBox { padding-right: 40px; }

QFrame#DialogFooter {
    background: #F5F2EA; border: none;
    border-bottom-left-radius: 30px; border-bottom-right-radius: 30px;
}
QDialog#NewTaskDialog QPushButton#BoardPrimary   { padding: 14px 30px; border-radius: 20px; font-size: 17px; }
QDialog#NewTaskDialog QPushButton#BoardSecondary { padding: 14px 30px; border-radius: 20px; font-size: 17px; }
QLabel#FormError { background: #FEE2E2; color: #991B1B; border-radius: 10px; padding: 8px 12px; font-size: 14px; }
/* pin badge on cards */
QFrame#PinChip  { background: #FEF3C7; border: 1px solid #F7E3A1; border-radius: 10px; }
QLabel#PinIcon  { font-size: 13px; background: transparent; }
QLabel#PinCount { font-size: 13px; font-weight: 700; color: #92400E; background: transparent; }