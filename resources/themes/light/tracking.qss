/* Fair Performance & Tracking (TrackingPage). Light theme.
   Values match Tokens.h: Background, Surface, SurfaceAlt, Track, Border, TextPrimary,
   TextMuted, Accent, AccentText, AccentSoft, SuccessSoft, Member1..Member6.
   Stat-card styling lives in home.qss (shared widget). */

#TrackingPage {
    background: #FAF8F5;
}

/* Reference: h2 22px / 800, p 13px */
#TrackingTitle {
    background: transparent;
    color: #1A1A1F;
    font-size: 22px;
    font-weight: 800;
}

#TrackingSubtitle {
    background: transparent;
    color: #6B6B73;
    font-size: 13px;
}

/* Caption line under a stat-card number (reference: 11px, secondary text) */
QLabel#TrackingCardCaption {
    background: transparent;
    border: none;
    color: #6B6B73;
    font-size: 11px;
}

/* Cards */
QFrame#TrackingCard {
    background: #FFFFFF;
    border: 1px solid #E7E2D6;
    border-radius: 14px;
}

QFrame#TrackingCardHeader {
    background: transparent;
    border: none;
    border-bottom: 1px solid #E7E2D6;
    border-radius: 0px;
}

QFrame#TrackingCardHeaderPlain {
    background: transparent;
    border: none;
}

/* Reference: card titles 14px / 700 */
QLabel#TrackingCardTitle {
    background: transparent;
    border: none;
    color: #1A1A1F;
    font-size: 14px;
    font-weight: 700;
}

/* Reference .badge-primary: radius 6, padding 3px 8px, 11px / 600 */
QLabel#TrackingBadge {
    background: #F3F0FF;
    border: 1px solid #5438DC;
    border-radius: 6px;
    color: #5438DC;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
}

/* Metric toggle (reference .btn-sm: radius 6, padding 5px 10px, 12px / 600) */
QPushButton#TrackingToggle {
    background: #F5F2EA;
    border: 1px solid #E7E2D6;
    border-radius: 6px;
    color: #1A1A1F;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 10px;
}

QPushButton#TrackingToggle:hover {
    background: #ECE7DC;
}

QPushButton#TrackingToggle:checked {
    background: #5438DC;
    border: 1px solid #5438DC;
    color: #FFFFFF;
}

/* Palette handed to the delegates through qproperty-* (LeaderboardTable). */
#LeaderboardTable {
    qproperty-textPrimaryColor: #1A1A1F;
    qproperty-textMutedColor: #6B6B73;
    qproperty-accentColor: #5438DC;
    qproperty-accentTextColor: #FFFFFF;
    qproperty-accentSoftColor: #F3F0FF;
    qproperty-successSoftColor: #D4F981;
    qproperty-trackColor: #ECE7DC;
    qproperty-surfaceAltColor: #F5F2EA;
    qproperty-borderColor: #E7E2D6;
    qproperty-member1Color: #EF4444;
    qproperty-member2Color: #6366F1;
    qproperty-member3Color: #10B981;
    qproperty-member4Color: #8B5CF6;
    qproperty-member5Color: #F59E0B;
    qproperty-member6Color: #EC4899;
}

/* Leaderboard table. Every cell is painted by a delegate; QSS still draws the row
   separator through ::item. Reference cell padding is 14px left and right. */
/* Complexity chart colours (ComplexityBarChart, qproperty-*). Same values as above. */
QWidget#ComplexityBarChart {
    qproperty-fillColor: #5438DC;
    qproperty-trackColor: #ECE7DC;
    qproperty-valueColor: #1A1A1F;
    qproperty-labelColor: #6B6B73;
}

QTableView#LeaderboardTable {
    background: transparent;
    border: none;
    color: #6B6B73;
    font-size: 13px;
    outline: 0;
}

QTableView#LeaderboardTable::item {
    background: transparent;
    border: none;
    border-bottom: 1px solid #ECE7DC;
    padding: 0px 14px;
}

QTableView#LeaderboardTable QHeaderView {
    background: transparent;
}

/* Reference th: padding 10px 14px, 13px / 600, secondary text, bottom border */
QTableView#LeaderboardTable QHeaderView::section {
    background: transparent;
    border: none;
    border-bottom: 1px solid #E7E2D6;
    color: #6B6B73;
    font-size: 13px;
    font-weight: 600;
    padding: 10px 14px;
}

QTableView#LeaderboardTable QTableCornerButton::section {
    background: transparent;
    border: none;
}
