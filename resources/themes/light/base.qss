QWidget {
    background-color: #FAF8F5;
    color: #1A1A1F;
    font-family: "Segoe UI";
}

QPushButton {
    background-color: #5438DC;
    color: #FFFFFF;
    border-radius: 8px;
    padding: 8px 16px;
}

/* ---------- sidebar (S1) ---------- */
QWidget#Sidebar {
    background-color: #F5F1E8;
    border-right: 1px solid #E7E2D6;
}

QWidget#Sidebar QPushButton#SidebarNavButton {
    color: #1A1A1F;
    background-color: #F5F1E8;
    border-right: 1px solid #E7E2D6;
}

QFrame#SidebarGitCard {
    background-color: #FFFFFF;
    border: 1px solid #E7E2D6;
    border-radius: 10px;
}

/* property "state" is "connected" or "disconnected" */
QLabel#SidebarGitDot {
    color: #6B6B73;
    font-size: 14px;
    border: none;
    background: transparent;
}

QLabel#SidebarGitDot[state="connected"] {
    color: #10B981;
}

QLabel#SidebarGitDot[state="disconnected"] {
    color: #6B6B73;
}

QLabel#SidebarGitTitle {
    color: #1A1A1F;
    font-size: 12px;
    font-weight: 700;
    border: none;
    background: transparent;
}

QLabel#SidebarGitSubtitle {
    color: #6B6B73;
    font-size: 11px;
    border: none;
    background: transparent;
}

QPushButton#SidebarSyncButton {
    background-color: #FAF8F5;
    color: #5438DC;
    border: 1px solid #E7E2D6;
    border-radius: 6px;
    padding: 0px;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#SidebarSyncButton:hover {
    background-color: #F3F0FF;
    border-color: #5438DC;
}
