
QWidget#ChaosSlicerPage {
    background-color: #FAF8F5;
    color: #1A1A1F;
    font-family: "Segoe UI", sans-serif;
}

QWidget#ChaosSlicerPage QScrollArea#slicerScrollArea {
    background: transparent;
    border: none;
}

QWidget#ChaosSlicerPage QWidget#slicerScrollContent {
    background: transparent;
}

QWidget#ChaosSlicerPage QFrame#card {
    background-color: #FFFFFF;
    border: 1px solid #E7E2D6;
    border-radius: 12px;
}

QWidget#ChaosSlicerPage QFrame#card QLabel {
    background: transparent;
}

QWidget#ChaosSlicerPage QLabel#cardTitle {
    color: #1A1A1F;
    font-size: 14px;
    font-weight: 600;
}

QWidget#ChaosSlicerPage QLabel#cardSubtitle {
    color: #6B6B73;
    font-size: 12px;
}

QWidget#ChaosSlicerPage QPushButton#primaryButton, QWidget#ChaosSlicerPage QPushButton#applyButton, QWidget#ChaosSlicerPage QPushButton#sliceButton {
    background-color: #5438DC;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
}

QWidget#ChaosSlicerPage QPushButton#primaryButton:hover, QWidget#ChaosSlicerPage QPushButton#applyButton:hover, QWidget#ChaosSlicerPage QPushButton#sliceButton:hover {
    background-color: #4526CB;
}

QWidget#ChaosSlicerPage QPushButton#primaryButton:pressed, QWidget#ChaosSlicerPage QPushButton#applyButton:pressed, QWidget#ChaosSlicerPage QPushButton#sliceButton:pressed {
    background-color: #381BAF;
}

QWidget#ChaosSlicerPage QPushButton#secondaryButton, QWidget#ChaosSlicerPage QPushButton#recalculateButton {
    background-color: #FFFFFF;
    color: #1A1A1F;
    border: 1px solid #E7E2D6;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
}

QWidget#ChaosSlicerPage QPushButton#secondaryButton:hover, QWidget#ChaosSlicerPage QPushButton#recalculateButton:hover {
    background-color: #F5F2EA;
}

QWidget#ChaosSlicerPage QPushButton#secondaryButton:pressed, QWidget#ChaosSlicerPage QPushButton#recalculateButton:pressed {
    background-color: #ECE7DC;
}

QWidget#ChaosSlicerPage QLabel#statusLabel {
    background-color: #D4F981;
    color: #1A1A1F;
    border-radius: 12px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 600;
}

QWidget#ChaosSlicerPage QLabel#emptyLabel {
    color: #6B6B73;
    font-size: 13px;
    padding: 28px;
}

QWidget#ChaosSlicerPage QWidget#WeightSlidersPanel {
    background-color: #FFFFFF;
    border: 1px solid #E7E2D6;
    border-radius: 12px;
}

QWidget#ChaosSlicerPage QWidget#WeightSlidersPanel QLabel, QWidget#ChaosSlicerPage QWidget#WeightSlidersPanel QSlider {
    background: transparent;
}

QWidget#ChaosSlicerPage QSlider::groove:horizontal {
    height: 6px;
    background: #ECE7DC;
    border-radius: 3px;
}

QWidget#ChaosSlicerPage QSlider::sub-page:horizontal {
    background: #5438DC;
    border-radius: 3px;
}

QWidget#ChaosSlicerPage QSlider::handle:horizontal {
    background: #5438DC;
    border: 2px solid #FFFFFF;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QWidget#ChaosSlicerPage QSlider::handle:horizontal:hover {
    background: #4526CB;
}

QWidget#ChaosSlicerPage QLabel#sliderNameLabel {
    color: #1A1A1F;
    font-size: 13px;
    font-weight: 500;
}

QWidget#ChaosSlicerPage QLabel#sliderValueLabel {
    color: #1A1A1F;
    font-size: 13px;
    font-weight: 600;
    min-width: 36px;
}

QWidget#ChaosSlicerPage QWidget#WeightSlidersPanel QLabel#sumLabel {
    background-color: #F3F0FF;
    color: #5438DC;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
}

QWidget#ChaosSlicerPage QTableView#assignmentsTable {
    background-color: #FFFFFF;
    border: 1px solid #E7E2D6;
    border-radius: 12px;
    gridline-color: #F5F2EA;
    selection-background-color: #F3F0FF;
    selection-color: #1A1A1F;
    outline: none;
}

QWidget#ChaosSlicerPage QHeaderView::section {
    background-color: #FAF8F5;
    color: #6B6B73;
    border: none;
    border-bottom: 1px solid #E7E2D6;
    padding: 10px 12px;
    font-size: 12px;
    font-weight: 600;
    text-align: left;
}

QWidget#ChaosSlicerPage QTableView::item {
    padding: 8px 12px;
    border-bottom: 1px solid #F5F2EA;
}

QWidget#ChaosSlicerPage QComboBox#overrideCombo {
    background-color: #FFFFFF;
    color: #1A1A1F;
    border: 1px solid #E7E2D6;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
}

QWidget#ChaosSlicerPage QComboBox#overrideCombo:hover {
    border-color: #5438DC;
}

QWidget#ChaosSlicerPage QComboBox#overrideCombo::drop-down {
    border: none;
    width: 18px;
}

QWidget#ChaosSlicerPage QComboBox#overrideCombo QAbstractItemView {
    background-color: #FFFFFF;
    color: #1A1A1F;
    border: 1px solid #E7E2D6;
    selection-background-color: #F3F0FF;
    selection-color: #1A1A1F;
}
