/* Team & Skills page (S2).
   Generic rules (card, buttons, inputs, slider, scroll area) are copies of the slicer ones,
   scoped under this page so the two pages do not depend on each other. */

QWidget#TeamSkillsPage {
    background-color: @Background;
    color: @TextPrimary;
    font-family: "Inter", "Segoe UI", sans-serif;
}

QWidget#TeamSkillsPage QScrollArea#slicerScrollArea {
    background: transparent;
    border: none;
}

QWidget#TeamSkillsPage QWidget#slicerScrollContent {
    background: transparent;
}

QWidget#TeamSkillsPage QFrame#card {
    background-color: @Surface;
    border: 1px solid @Border;
    border-radius: 12px;
}

QWidget#TeamSkillsPage QFrame#card QLabel {
    background: transparent;
}

QWidget#TeamSkillsPage QLabel#cardTitle {
    color: @TextPrimary;
    font-size: 14px;
    font-weight: 600;
}

QWidget#TeamSkillsPage QLabel#cardSubtitle {
    color: @TextMuted;
    font-size: 12px;
}

QWidget#TeamSkillsPage QPushButton#primaryButton {
    background-color: @Accent;
    color: @AccentText;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
}

QWidget#TeamSkillsPage QPushButton#primaryButton:hover {
    background-color: @AccentHover;
}

QWidget#TeamSkillsPage QPushButton#primaryButton:pressed {
    background-color: @AccentPressed;
}

QWidget#TeamSkillsPage QPushButton#secondaryButton {
    background-color: @Surface;
    color: @TextPrimary;
    border: 1px solid @Border;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
}

QWidget#TeamSkillsPage QPushButton#secondaryButton:hover {
    background-color: @SurfaceAlt;
}

QWidget#TeamSkillsPage QPushButton#secondaryButton:pressed {
    background-color: @Track;
}

QWidget#TeamSkillsPage QLabel#statusLabel {
    background-color: @SuccessSoft;
    color: @TextPrimary;
    border-radius: 12px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 600;
}

QWidget#TeamSkillsPage QLabel#emptyLabel {
    color: @TextMuted;
    font-size: 13px;
    padding: 28px;
}

QWidget#TeamSkillsPage QLabel#sliderValueLabel {
    color: @TextPrimary;
    font-size: 13px;
    font-weight: 600;
    min-width: 36px;
}

QWidget#TeamSkillsPage QSlider::groove:horizontal {
    height: 6px;
    background: @Track;
    border-radius: 3px;
}

QWidget#TeamSkillsPage QSlider::sub-page:horizontal {
    background: @Accent;
    border-radius: 3px;
}

QWidget#TeamSkillsPage QSlider::handle:horizontal {
    background: @Accent;
    border: 2px solid @Surface;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QWidget#TeamSkillsPage QSlider::handle:horizontal:hover {
    background: @AccentHover;
}

/* ---------- inputs ---------- */
QWidget#TeamSkillsPage QLineEdit#lightInput {
    background-color: @Background;
    color: @TextPrimary;
    border: 1px solid @Border;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 13px;
}

QWidget#TeamSkillsPage QLineEdit#lightInput:focus {
    border: 1px solid @Accent;
    background-color: @Surface;
}

QWidget#TeamSkillsPage QCheckBox#leadCheck {
    color: @TextPrimary;
    font-size: 13px;
    font-weight: 500;
    spacing: 6px;
    background: transparent;
}

QWidget#TeamSkillsPage QComboBox#roleCombo {
    background-color: @Background;
    color: @TextPrimary;
    border: 1px solid @Border;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
    min-width: 160px;
}

QWidget#TeamSkillsPage QComboBox#roleCombo:hover, QWidget#TeamSkillsPage QComboBox#roleCombo:focus {
    border: 1px solid @Accent;
    background-color: @Surface;
}

QWidget#TeamSkillsPage QComboBox#roleCombo::drop-down {
    border: none;
    width: 24px;
}

QWidget#TeamSkillsPage QComboBox#roleCombo QAbstractItemView {
    background-color: @Surface;
    color: @TextPrimary;
    border: 1px solid @Border;
    selection-background-color: @AccentSoft;
    selection-color: @Accent;
    padding: 4px;
}

/* ---------- member card ---------- */
/* Avatar fills: property memberColor 1..6 = the Member1..Member6 colours of Tokens.h. */
QWidget#TeamSkillsPage QFrame#card QLabel#memberAvatar {
    color: @TextInverse;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 700;
}

QWidget#TeamSkillsPage QFrame#card QLabel#memberAvatar[memberColor="1"] { background-color: @Member1; }
QWidget#TeamSkillsPage QFrame#card QLabel#memberAvatar[memberColor="2"] { background-color: @Member2; }
QWidget#TeamSkillsPage QFrame#card QLabel#memberAvatar[memberColor="3"] { background-color: @Member3; }
QWidget#TeamSkillsPage QFrame#card QLabel#memberAvatar[memberColor="4"] { background-color: @Member4; }
QWidget#TeamSkillsPage QFrame#card QLabel#memberAvatar[memberColor="5"] { background-color: @Member5; }
QWidget#TeamSkillsPage QFrame#card QLabel#memberAvatar[memberColor="6"] { background-color: @Member6; }

QWidget#TeamSkillsPage QFrame#card QLabel#leadBadge {
    background-color: @AccentSoft;
    color: @Accent;
    border-radius: 8px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 700;
}

QWidget#TeamSkillsPage QFrame#card QLabel#velocityBadge {
    background-color: @Background;
    color: @TextPrimary;
    border: 1px solid @Border;
    border-radius: 8px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QWidget#TeamSkillsPage QPushButton#editRoleButton {
    background-color: @Background;
    color: @Accent;
    border: 1px solid @Border;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QWidget#TeamSkillsPage QPushButton#editRoleButton:hover {
    background-color: @AccentSoft;
    border-color: @Accent;
}

QWidget#TeamSkillsPage QPushButton#removeMemberButton {
    background-color: @Background;
    color: @DangerAction;
    border: 1px solid @DangerSoft;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QWidget#TeamSkillsPage QPushButton#removeMemberButton:hover {
    background-color: @DangerSoft;
    color: @DangerText;
    border-color: @DangerBorder;
}

QWidget#TeamSkillsPage QPushButton#saveRoleButton {
    background-color: @Accent;
    color: @AccentText;
    border: none;
    border-radius: 6px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QWidget#TeamSkillsPage QPushButton#saveRoleButton:hover {
    background-color: @AccentHover;
}

QWidget#TeamSkillsPage QPushButton#cancelRoleButton {
    background-color: @Background;
    color: @TextMuted;
    border: 1px solid @Border;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

QWidget#TeamSkillsPage QPushButton#cancelRoleButton:hover {
    background-color: @SurfaceAlt;
}

QWidget#TeamSkillsPage QFrame#card QFrame#cardDivider {
    background-color: @SurfaceAlt;
    border: none;
    max-height: 1px;
}

/* ---------- skill rating matrix ---------- */
QWidget#TeamSkillsPage QWidget#skillCell {
    background: transparent;
}

QWidget#TeamSkillsPage QFrame#card QLabel#skillLabel {
    color: @TextMuted;
    font-size: 12px;
    font-weight: 500;
}

/* property "active" is "true" for the rating steps up to the member's rating */
QWidget#TeamSkillsPage QPushButton#ratingButton {
    background-color: @Background;
    color: @TextMuted;
    border: 1px solid @Border;
    border-radius: 6px;
    padding: 0px;
    font-size: 11px;
    font-weight: 600;
}

QWidget#TeamSkillsPage QPushButton#ratingButton:hover {
    background-color: @AccentSoft;
    color: @Accent;
    border-color: @Accent;
}

QWidget#TeamSkillsPage QPushButton#ratingButton[active="true"] {
    background-color: @Accent;
    color: @AccentText;
    border: none;
    font-weight: 700;
}

QWidget#TeamSkillsPage QPushButton#ratingButton[active="true"]:hover {
    background-color: @AccentHover;
    color: @AccentText;
}

/* ---------- settings switches ---------- */
/* Checkable buttons: the text says "On" or "Off", the fill is only a second cue. */
QWidget#TeamSkillsPage QPushButton#autoMatchSwitch,
QWidget#TeamSkillsPage QPushButton#smartAssignSwitch {
    background-color: @Background;
    color: @TextPrimary;
    border: 1px solid @Border;
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 600;
}

QWidget#TeamSkillsPage QPushButton#autoMatchSwitch:hover,
QWidget#TeamSkillsPage QPushButton#smartAssignSwitch:hover {
    background-color: @SurfaceAlt;
}

QWidget#TeamSkillsPage QPushButton#autoMatchSwitch:checked,
QWidget#TeamSkillsPage QPushButton#smartAssignSwitch:checked {
    background-color: @Accent;
    color: @AccentText;
    border: 1px solid @Accent;
}

QWidget#TeamSkillsPage QPushButton#autoMatchSwitch:checked:hover,
QWidget#TeamSkillsPage QPushButton#smartAssignSwitch:checked:hover {
    background-color: @AccentHover;
}

QWidget#TeamSkillsPage QPushButton#autoMatchSwitch:focus,
QWidget#TeamSkillsPage QPushButton#smartAssignSwitch:focus {
    border: 2px solid @TextPrimary;
    padding: 5px 15px; /* the border grows by 1 px, so the button keeps its size */
}

QWidget#TeamSkillsPage QPushButton#resolveConflict:focus {
    border: 2px solid @TextPrimary;
    padding: 2px 11px;
}

/* ---------- assignment / clash column ---------- */
QWidget#TeamSkillsPage QWidget#assignmentColumn {
    background: transparent;
}

QWidget#TeamSkillsPage QFrame#card QLabel#assignmentText {
    color: @TextPrimary;
    font-size: 12px;
}

QWidget#TeamSkillsPage QFrame#card QLabel#clashBadge {
    background-color: @DangerSoft;
    color: @DangerText;
    border: 1px solid @DangerBorder;
    border-radius: 8px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 700;
}

QWidget#TeamSkillsPage QFrame#card QLabel#conflictText {
    color: @TextMuted;
    font-size: 12px;
}

QWidget#TeamSkillsPage QPushButton#resolveConflict {
    background-color: @Accent;
    color: @AccentText;
    border: 1px solid @Accent;
    border-radius: 6px;
    padding: 3px 12px;
    font-size: 12px;
    font-weight: 600;
}

QWidget#TeamSkillsPage QPushButton#resolveConflict:hover {
    background-color: @AccentHover;
}

QWidget#TeamSkillsPage QPushButton#resolveConflict:pressed {
    background-color: @AccentPressed;
}
